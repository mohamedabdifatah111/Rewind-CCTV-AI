DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# postgres (default) or sqlite (tests / quick local only: search falls back to a simpler matcher)
DB_ENGINE=postgres
DB_NAME=rewind
DB_USER=rewind
DB_PASSWORD=rewind
DB_HOST=localhost
DB_PORT=5432

GEMINI_API_KEY=your_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

MAX_UPLOAD_SIZE_MB=500
FRAME_INTERVAL_SECONDS=2
FRAME_MAX_SIDE_PX=1024
SEARCH_MAX_RESULTS=50
DATA_RETENTION_DAYS=

# sync (blocks the request, dev only) | thread (in-process) | celery (recommended)
PROCESSING_MODE=celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Set true once you add login. The MVP has no user accounts.
API_REQUIRE_AUTH=false
